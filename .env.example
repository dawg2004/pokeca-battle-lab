# Enables the experimental server-side adapter that reads public deck pages from pokemon-card.com.
# POKECA BATTLE LAB is personal, local-use software: pokemon-card.com's terms of use (confirmed
# 2026-08-28, https://www.pokemon-card.com/policy.html) restrict this data to personal enjoyment
# and forbid using it on another public network. Keep this feature for local development only.
# The app also hard-blocks it automatically when it detects a known public hosting platform
# (Vercel, Netlify, Render, Railway, Fly.io, Cloudflare Pages), regardless of this flag.
ENABLE_OFFICIAL_DECK_FETCH=true
